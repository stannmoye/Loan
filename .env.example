NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=mysql://loan_app:replace-me@127.0.0.1:3306/loan_platform
# Optional until an administrator identity provider is configured.
# Protected administrator routes return HTTP 503 until all three values are valid.
# JWT_ISSUER=https://your-auth-provider.example
# JWT_AUDIENCE=loan-platform-api
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\nPASTE_REAL_RS256_PUBLIC_KEY_HERE\\n-----END PUBLIC KEY-----"
CORS_ORIGIN=http://localhost:5173

# Customer identity remains disabled until a dedicated external identity provider
# issues RS256 customer tokens with principal_type=customer, verified email, unique
# subject, expiry and session (sid). Never reuse administrator keys.
# CUSTOMER_JWT_ISSUER=https://identity.example.invalid/
# CUSTOMER_JWT_AUDIENCE=loan-platform-customer-api
# CUSTOMER_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\\nREPLACE_WITH_CUSTOMER_PUBLIC_KEY\\n-----END PUBLIC KEY-----"
#
# Generate a dedicated random 32-byte AES-256 key and store it in the secret manager.
# Do not commit the real value. It protects customer profile fields.
# CUSTOMER_PROFILE_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
#
# Onboarding stays disabled until approved legal-document versions are configured.
# CUSTOMER_PRIVACY_NOTICE_VERSION=privacy-2026-01
# CUSTOMER_TERMS_OF_SERVICE_VERSION=terms-2026-01
# CUSTOMER_APPLICATION_DECLARATION_VERSION=application-declaration-2026-01
