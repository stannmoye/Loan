NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=mysql://loan_app:replace-me@127.0.0.1:3306/loan_platform
JWT_ISSUER=loan-platform-auth
JWT_AUDIENCE=loan-platform-api
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_REAL_PUBLIC_KEY\n-----END PUBLIC KEY-----"
CORS_ORIGIN=http://localhost:5173

# Customer identity is disabled until an external identity provider has been
# configured to issue RS256 customer tokens with principal_type=customer,
# a verified email claim, a unique subject, an exp claim and a session (sid).
# Use a distinct customer audience/public key. Never reuse a test or admin key.
# CUSTOMER_JWT_ISSUER=https://identity.example.invalid/
# CUSTOMER_JWT_AUDIENCE=loan-platform-customer-api
# CUSTOMER_JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_CUSTOMER_PUBLIC_KEY\n-----END PUBLIC KEY-----"
#
# Generate a dedicated random 32-byte AES-256 key and store it in the secret
# manager. Do not commit the real value. It protects customer profile fields.
# CUSTOMER_PROFILE_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
#
# Onboarding stays disabled until the exact published legal-document versions
# have been approved for the launch entity and jurisdiction.
# CUSTOMER_PRIVACY_NOTICE_VERSION=privacy-2026-01
# CUSTOMER_TERMS_OF_SERVICE_VERSION=terms-2026-01

# Exact approved application declaration version. Draft application creation stays disabled until set.
# CUSTOMER_APPLICATION_DECLARATION_VERSION=application-declaration-2026-01
